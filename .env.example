# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=your_supabase_postgres_connection_string

# Claude API — drives Анна's conversation
ANTHROPIC_API_KEY=your_anthropic_api_key
ANNA_MODEL=claude-haiku-4-5

# ElevenLabs — text-to-speech + speech-to-text for voice notes (optional; app falls back to text-only)
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=your_elevenlabs_voice_id

# Telegram — free, no per-message cost. Create a bot via @BotFather and paste its token.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Mila
MILA_TIMEZONE=Asia/Jerusalem

# Admin
ADMIN_KEY=choose_a_secret
CRON_SECRET=choose_a_secret
